# Copy this file to .env and paste in your own OpenWeatherMap key.
# Get a free key at https://home.openweathermap.org/users/sign_up
# A new key is not active right away, so sign up early in the session.
# Never commit your real .env file, because when you push your changes to
# GitHub, your API keys and other secrets will be visible to the public.
API_KEY=YOUR-API-KEY-GOES-HERE
